# 真实模型路径所需（不提交真实密钥）
# DeepSeek 官方 API 采用 OpenAI 兼容协议，任何 OpenAI 兼容端点都可直接替换
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
# 模型 id 取自 GET https://api.deepseek.com/models 实测（deepseek-v4-pro / deepseek-flash）
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0

# 执行上限：模型-工具往返的最大次数，达到即返回未完成状态
MAX_STEPS=12

# 草稿账本路径（默认 data/drafts.json，用于重复提交去重）
# DRAFT_LEDGER=
